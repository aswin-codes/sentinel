# Copy to .env and adjust
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qahub

# Clerk (https://dashboard.clerk.com → your app → API keys).
# Required. For local dev without a Clerk account run `npx clerk@latest init` (writes temporary
# "keyless" keys; claim the app later from the "Configure your application" prompt).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
